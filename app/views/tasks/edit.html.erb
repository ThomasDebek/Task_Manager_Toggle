<% content_for :title, "Editing task" %>

<!-- PAGE HEADER -->
<header class="mb-8 flex items-center justify-between">
  <h1 class="text-3xl font-semibold text-white">
    Editing Task
  </h1>

  <%= link_to "Back to tasks", tasks_path,
              class: "rounded-lg bg-slate-700 px-5 py-2.5 text-sm font-medium text-slate-200 hover:bg-slate-600 transition" %>
</header>

<!-- TASK FORM -->
<div class="rounded-xl border border-slate-700 bg-slate-800 p-6 shadow transition hover:-translate-y-0.5 hover:shadow-lg">
  <%= render "form", task: @task %>
</div>

<!-- ACTION LINKS -->
<div class="mt-6 flex gap-4">
  <%= link_to "Show this task", @task,
              class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 transition" %>
</div>